FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
ARG VITE_ENABLE_PASSWORD_LOGIN=true
ENV VITE_ENABLE_PASSWORD_LOGIN=$VITE_ENABLE_PASSWORD_LOGIN
ARG VITE_ENABLE_GOOGLE_LOGIN=false
ENV VITE_ENABLE_GOOGLE_LOGIN=$VITE_ENABLE_GOOGLE_LOGIN
ARG VITE_INSECURE_HTTP_DEPLOYMENT=false
ENV VITE_INSECURE_HTTP_DEPLOYMENT=$VITE_INSECURE_HTTP_DEPLOYMENT

RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
